      "headers": {
        "Authorization": "Bearer {key}"
      }
    },
    "victoria-logs-mcp": {
      "type": "http",
      "url": "https://vmauth.zooneon.dev:5443/victoria-logs-mcp/mcp",
      "headers": {
        "Authorization": "Bearer {key}"
      }
    }
  }
}